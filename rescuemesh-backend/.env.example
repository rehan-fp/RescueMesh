# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Final project: hosted PostgreSQL (Neon / Supabase / Railway / Render / etc.)
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# Local Stage 1 fallback:
DATABASE_URL=sqlite:///rescuemesh.db

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# --- ESP32 gateway REST ingest (POST /api/v1/sos) ---
# Sent by the gateway in the X-API-Key header. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Comma-separate multiple keys to rotate without downtime.
GATEWAY_API_KEY=change-me-gateway-key
# Same device_id + sequence + category within this many seconds is ignored as a replay.
SOS_DEDUP_WINDOW_SECONDS=300

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Environment ---
# Set APP_ENV=production on Railway: startup then refuses default secrets, SQLite,
# demo seeding and testing endpoints.
APP_ENV=development
# Local development only: seed demo users/teams/devices/incidents into an empty DB
# and enable POST /api/v1/testing/sos. Both default to false.
SEED_DEMO_DATA=true
ENABLE_TESTING_ENDPOINTS=true
